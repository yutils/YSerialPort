<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_list_item_round"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/v_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Modbus 读保持寄存器" />

        <TextView
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:textColor="@color/c_on_secondary_container"
            android:textSize="11sp"
            tools:text="HEX" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send"
            style="@style/Widget.YS.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:minWidth="66dp"
            android:text="@string/command_send"
            android:textSize="12sp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_more"
            style="@style/Widget.YS.IconButton.Small"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/command_more_desc"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_panel_soft"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:padding="8dp"
        android:textColor="@color/c_text_secondary"
        android:textSize="12sp"
        tools:text="01 03 00 00 00 0A C5 CD" />

</LinearLayout>
